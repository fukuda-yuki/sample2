<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MusicStore.Evaluator</RootNamespace>
    <AssemblyName>MusicStore.Evaluator</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      The SDK embeds the working tree's commit into AssemblyInformationalVersion by
      default. That makes the built assembly's sha256 change on every commit, even a
      documentation-only one, so the recorded "which build scored this" value could
      never match the commit that records it. The evaluator does not read this
      attribute; turning it off keeps the identity a function of source, path and SDK.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!--
      Turning off the attribute above is not enough. The SDK also writes a sourcelink
      document containing the commit (".../raw.githubusercontent.com/<owner>/<repo>/<sha>/*")
      and Roslyn records it in the portable PDB, whose id the assembly carries in its
      debug directory. The commit therefore reached the assembly's bytes indirectly and
      the sha256 still moved with every commit. The evaluator is a local, sealed tool and
      nothing reads this document, so source link is turned off as well.
    -->
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <!--
      保存契約（Orders 表の OrderId 列）に沿って注文行の存在を読み取り専用で観測するため。
      成果物の内部スキーマを推測せずに済ませるには、SQLite を直接読む必要がある
      （docs/quality-spec.md §4.6）。
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
  </ItemGroup>

</Project>
