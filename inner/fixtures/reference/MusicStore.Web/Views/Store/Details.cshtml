@using System.Globalization
@model MusicStore.Web.Models.Album
@{
    ViewData["Title"] = "Album - " + Model.Title;
}

<h2>@Model.Title</h2>

<p>
    <img alt="@Model.Title" src="@Model.AlbumArtUrl" />
</p>

<div id="album-details">
    <p>
        <em>Genre:</em>
        @Model.Genre.Name
    </p>
    <p>
        <em>Artist:</em>
        @Model.Artist.Name
    </p>
    <p>
        <em>Price:</em>
        @Model.Price.ToString("0.00", CultureInfo.InvariantCulture)
    </p>
    <p class="button">
        <a href="/ShoppingCart/AddToCart/@Model.AlbumId">Add to cart</a>
    </p>
</div>
